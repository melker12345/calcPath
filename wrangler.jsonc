{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "calcpath",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// `npm run build` writes the whole site here as static files. Cloudflare
	// serves them (and out/_redirects, out/_headers) without running the
	// worker; only these paths, and paths with no file, reach worker/index.ts,
	// which also answers with out/404.html.
	"assets": {
		"directory": "out",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"run_worker_first": ["/api/*", "/report-data/*"]
	},
	"observability": { "enabled": true }
}
