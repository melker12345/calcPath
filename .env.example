# All four are optional. Without them the site builds and runs; the report
# form answers 503 and /admin/feedback cannot sign in.

# Supabase project URL (public).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (public): only used for the admin sign-in.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key (secret): the worker writes and reads the reports table with it.
# In production all four are Cloudflare worker variables or secrets (npx wrangler secret put …);
# the two NEXT_PUBLIC_ ones must also be set where `next build` runs.
SUPABASE_SERVICE_ROLE_KEY=
# The one account allowed into /admin/feedback (created with scripts/create-admin.ts).
ADMIN_EMAIL=
