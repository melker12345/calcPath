{
  "name": "calcpath",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/cloudflare-assets.ts",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint",
    "test": "vitest run",
    "content:validate": "npx tsx scripts/validate-content.ts",
    "content:answers": "npx tsx scripts/validate-answers.ts",
    "content:latex": "npx tsx scripts/validate-latex.ts",
    "content:problemsets": "npx tsx scripts/validate-problemsets.ts",
    "content:audit": "npx tsx scripts/audit-book-style.ts",
    "content:contrast": "npx tsx scripts/audit-contrast.ts",
    "content:figures": "npx tsx scripts/verify-figures.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.94.1",
    "katex": "^0.16.28",
    "marked": "^18.0.4",
    "mathjs": "^15.2.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-mathquill": "^1.0.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.151.1"
  }
